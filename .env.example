# BotolaHub Environment Configuration Template

# Node Environment
NODE_ENV=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://botolahub:botolahub_secret@localhost:5432/botolahub_db?schema=public"

# Cache & Queue Configuration (Redis 7)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# API Server Configuration
PORT=3001
API_URL="http://localhost:3001"
JWT_SECRET="botolahub_dev_jwt_secret_change_in_production_32chars_min"
JWT_REFRESH_SECRET="botolahub_dev_refresh_secret_change_in_production"

# Web Client Configuration
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Client Configuration
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# Mobile Client Configuration
EXPO_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Football Data Provider Configuration (Mock by default for local development)
FOOTBALL_DATA_PROVIDER="mock"
FOOTBALL_DATA_API_KEY=""
