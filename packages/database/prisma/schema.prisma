datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum Position {
  GK
  DEF
  MID
  FWD
}

enum PlayerStatus {
  AVAILABLE
  INJURED
  SUSPENDED
  UNKNOWN
}

enum GameweekStatus {
  SCHEDULED
  ACTIVE
  FINISHED
  LOCKED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum TransferType {
  IN
  OUT
}

enum LeagueMemberRole {
  OWNER
  MEMBER
}

enum IngestionStatus {
  PENDING
  SUCCESS
  FAILED
  PARTIAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  displayName       String
  passwordHash      String
  role              UserRole @default(USER)
  isEmailVerified   Boolean  @default(false)
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions     UserSession[]
  fantasyTeams FantasyTeam[]
  ownedLeagues FantasyLeague[]
  memberships  FantasyLeagueMember[]
  auditLogs    AuditLog[]

  @@index([email])
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  familyId         String   @default(uuid())
  replacedBy       String?
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([refreshTokenHash])
}

// ─── Football Domain ─────────────────────────────────────────────────────────

model Competition {
  id        String   @id @default(uuid())
  name      String
  nameAr    String
  nameFr    String
  country   String   @default("Morocco")
  season    Season[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Season {
  id            String   @id @default(uuid())
  competitionId String
  label         String // e.g. "2024-25"
  isActive      Boolean  @default(false)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition     Competition      @relation(fields: [competitionId], references: [id])
  clubs           Club[]
  gameweeks       Gameweek[]
  playerSeasons   PlayerSeason[]
  scoringRuleSets ScoringRuleSet[]
  fantasyTeams    FantasyTeam[]

  @@unique([competitionId, label])
  @@index([isActive])
}

model Club {
  id        String   @id @default(uuid())
  seasonId  String
  name      String
  nameAr    String
  nameFr    String
  shortName String
  city      String
  crestUrl  String? // placeholder SVG path
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season       Season         @relation(fields: [seasonId], references: [id])
  players      PlayerSeason[]
  homeFixtures Fixture[]      @relation("HomeClub")
  awayFixtures Fixture[]      @relation("AwayClub")

  @@unique([seasonId, shortName])
  @@index([seasonId])
}

model Player {
  id          String    @id @default(uuid())
  firstName   String
  lastName    String
  firstNameAr String?
  lastNameAr  String?
  position    Position
  nationality String    @default("Moroccan")
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seasons          PlayerSeason[]
  providerMappings ProviderEntityMapping[]
}

model PlayerSeason {
  id          String       @id @default(uuid())
  playerId    String
  seasonId    String
  clubId      String
  status      PlayerStatus @default(AVAILABLE)
  pricePoints Int // stored as integer tenths: 55 = 5.5 credits
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  player        Player               @relation(fields: [playerId], references: [id])
  season        Season               @relation(fields: [seasonId], references: [id])
  club          Club                 @relation(fields: [clubId], references: [id])
  fixtureStats  PlayerFixtureStats[]
  fantasyScores FantasyPlayerScore[]
  squadMembers  FantasySquadMember[]
  lineupPlayers GameweekLineupPlayer[]

  @@unique([playerId, seasonId])
  @@index([seasonId, clubId])
  @@index([seasonId, status])
  @@index([pricePoints])
}

model Gameweek {
  id          String         @id @default(uuid())
  seasonId    String
  number      Int // 1–30
  status      GameweekStatus @default(SCHEDULED)
  deadlineUtc DateTime
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  season             Season                     @relation(fields: [seasonId], references: [id])
  fixtures           Fixture[]
  gameweekLineups    GameweekLineup[]
  fantasyTeamScores  FantasyTeamGameweekScore[]
  leaderboardEntries LeaderboardEntry[]
  ingestionRuns      IngestionRun[]

  @@unique([seasonId, number])
  @@index([seasonId, status])
}

model Fixture {
  id         String        @id @default(uuid())
  gameweekId String
  homeClubId String
  awayClubId String
  status     FixtureStatus @default(SCHEDULED)
  kickoffUtc DateTime
  homeScore  Int?
  awayScore  Int?
  venue      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  gameweek         Gameweek                @relation(fields: [gameweekId], references: [id])
  homeClub         Club                    @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub         Club                    @relation("AwayClub", fields: [awayClubId], references: [id])
  events           FixtureEvent[]
  playerStats      PlayerFixtureStats[]
  providerMappings ProviderEntityMapping[]

  @@index([gameweekId])
  @@index([kickoffUtc])
}

model FixtureEvent {
  id        String   @id @default(uuid())
  fixtureId String
  minute    Int
  type      String // GOAL, ASSIST, YELLOW_CARD, RED_CARD, SUBSTITUTION, etc.
  playerId  String?
  detail    String?
  createdAt DateTime @default(now())

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureId])
}

model PlayerFixtureStats {
  id             String   @id @default(uuid())
  playerSeasonId String
  fixtureId      String
  minutesPlayed  Int      @default(0)
  goals          Int      @default(0)
  assists        Int      @default(0)
  cleanSheet     Boolean  @default(false)
  yellowCards    Int      @default(0)
  redCards       Int      @default(0)
  saves          Int      @default(0)
  penaltySaves   Int      @default(0)
  penaltyMisses  Int      @default(0)
  ownGoals       Int      @default(0)
  goalsConceded  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id])
  fixture      Fixture      @relation(fields: [fixtureId], references: [id])

  @@unique([playerSeasonId, fixtureId])
  @@index([fixtureId])
}

// ─── Fantasy Team ─────────────────────────────────────────────────────────────

model FantasyTeam {
  id           String   @id @default(uuid())
  userId       String
  seasonId     String
  name         String
  budgetPoints Int      @default(1000) // 100.0 credits in tenths
  totalPoints  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user               User                       @relation(fields: [userId], references: [id])
  season             Season                     @relation(fields: [seasonId], references: [id])
  squadMembers       FantasySquadMember[]
  gameweekLineups    GameweekLineup[]
  transfers          Transfer[]
  gameweekScores     FantasyTeamGameweekScore[]
  leaderboardEntries LeaderboardEntry[]
  leagueMembers      FantasyLeagueMember[]

  @@unique([userId, seasonId])
  @@index([seasonId, totalPoints])
}

model FantasySquadMember {
  id             String   @id @default(uuid())
  fantasyTeamId  String
  playerSeasonId String
  purchasePrice  Int // price at time of purchase in tenths
  createdAt      DateTime @default(now())

  fantasyTeam  FantasyTeam  @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id])

  @@unique([fantasyTeamId, playerSeasonId])
  @@index([fantasyTeamId])
}

model GameweekLineup {
  id            String   @id @default(uuid())
  fantasyTeamId String
  gameweekId    String
  captainId     String? // playerSeasonId
  viceCaptainId String? // playerSeasonId
  isFinalised   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fantasyTeam FantasyTeam            @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  gameweek    Gameweek               @relation(fields: [gameweekId], references: [id])
  players     GameweekLineupPlayer[]

  @@unique([fantasyTeamId, gameweekId])
  @@index([gameweekId])
}

model GameweekLineupPlayer {
  id             String  @id @default(uuid())
  lineupId       String
  playerSeasonId String
  isStarting     Boolean @default(true)
  benchOrder     Int? // 0-3 for bench players; null for starters

  lineup       GameweekLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerSeason PlayerSeason   @relation(fields: [playerSeasonId], references: [id])

  @@unique([lineupId, playerSeasonId])
  @@index([lineupId])
}

model Transfer {
  id             String       @id @default(uuid())
  fantasyTeamId  String
  gameweekId     String
  type           TransferType
  playerSeasonId String
  pricePoints    Int // price at transfer time in tenths
  pointsCost     Int          @default(0) // 0 for free, 4 for additional
  createdAt      DateTime     @default(now())

  fantasyTeam FantasyTeam @relation(fields: [fantasyTeamId], references: [id])

  @@index([fantasyTeamId, gameweekId])
}

// ─── Scoring ──────────────────────────────────────────────────────────────────

model FantasyPlayerScore {
  id             String   @id @default(uuid())
  playerSeasonId String
  gameweekId     String
  points         Int
  breakdown      Json // { minutesPoints: 2, goalPoints: 6, ... }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  playerSeason PlayerSeason @relation(fields: [playerSeasonId], references: [id])

  @@unique([playerSeasonId, gameweekId])
  @@index([gameweekId])
}

model FantasyTeamGameweekScore {
  id            String   @id @default(uuid())
  fantasyTeamId String
  gameweekId    String
  points        Int
  transferCost  Int      @default(0)
  captainBonus  Int      @default(0)
  breakdown     Json
  isProvisional Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fantasyTeam FantasyTeam @relation(fields: [fantasyTeamId], references: [id])
  gameweek    Gameweek    @relation(fields: [gameweekId], references: [id])

  @@unique([fantasyTeamId, gameweekId])
  @@index([gameweekId])
}

// ─── Leagues & Leaderboards ───────────────────────────────────────────────────

model FantasyLeague {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  joinCode  String   @unique @default(cuid())
  isGlobal  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner              User                  @relation(fields: [ownerId], references: [id])
  members            FantasyLeagueMember[]
  leaderboardEntries LeaderboardEntry[]

  @@index([joinCode])
  @@index([isGlobal])
}

model FantasyLeagueMember {
  id            String           @id @default(uuid())
  leagueId      String
  fantasyTeamId String
  userId        String
  role          LeagueMemberRole @default(MEMBER)
  joinedAt      DateTime         @default(now())

  league      FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  fantasyTeam FantasyTeam   @relation(fields: [fantasyTeamId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@unique([leagueId, fantasyTeamId])
  @@index([leagueId])
}

model LeaderboardEntry {
  id            String   @id @default(uuid())
  leagueId      String
  fantasyTeamId String
  gameweekId    String? // null = overall ranking
  rank          Int
  points        Int
  previousRank  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  league      FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  fantasyTeam FantasyTeam   @relation(fields: [fantasyTeamId], references: [id])
  gameweek    Gameweek?     @relation(fields: [gameweekId], references: [id])

  @@unique([leagueId, fantasyTeamId, gameweekId])
  @@index([leagueId, gameweekId, rank])
}

// ─── Operational / Infra ─────────────────────────────────────────────────────

model ProviderEntityMapping {
  id         String   @id @default(uuid())
  provider   String // "mock" | "apifootball"
  entityType String // "player" | "fixture" | "club"
  providerId String // external provider's ID
  playerId   String?
  fixtureId  String?
  createdAt  DateTime @default(now())

  player  Player?  @relation(fields: [playerId], references: [id])
  fixture Fixture? @relation(fields: [fixtureId], references: [id])

  @@unique([provider, entityType, providerId])
  @@index([provider, entityType])
}

model IngestionRun {
  id          String          @id @default(uuid())
  gameweekId  String?
  provider    String
  jobType     String // "players" | "fixtures" | "live_events" | "final_stats"
  status      IngestionStatus @default(PENDING)
  recordCount Int             @default(0)
  errorCount  Int             @default(0)
  errorDetail String?
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?

  gameweek Gameweek? @relation(fields: [gameweekId], references: [id])

  @@index([gameweekId, status])
}

model ScoringRuleSet {
  id        String   @id @default(uuid())
  seasonId  String
  version   Int
  isActive  Boolean  @default(false)
  rules     Json // structured scoring config
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, version])
}

model ScoringAdjustment {
  id             String   @id @default(uuid())
  playerSeasonId String?
  fantasyTeamId  String?
  gameweekId     String
  points         Int
  reason         String
  appliedBy      String // admin user ID
  createdAt      DateTime @default(now())

  @@index([gameweekId])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  action     AuditAction
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
